{
  "name": "tweakloop",
  "version": "0.1.0",
  "description": "Tweakloop — a local-first information system for human–agent artifact iteration. Shape agent work. See what changed. Ship what you approved.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "tweak": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "web",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "tweak": "node dist/cli/index.js"
  },
  "dependencies": {
    "ajv": "^8.17.0",
    "better-sqlite3": "^12.0.0",
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "@biomejs/biome"
    ]
  }
}
